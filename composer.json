{
  "require": {
    "php": "^8.0",
    "vlucas/phpdotenv": "^5.7"
  },
  "config": {
    "platform": {
      "php": "8.0.0"
    },
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
      "ml-build": [
        "code2prompt . --include='*.php' --token-map --encoding=cl100k --output-format=xml  --exclude='*.l10n.php,parsedown.php' --output-file='ml/memory-php.xml'"
      ],
      "commit": "./.scripts/commit.sh --app",
      "dy-core-copy": "./dy-core/update.sh --copy-only",
      "dy-core-publish": "./dy-core/update.sh --publish",
      "start": [
          "@start-apache"
      ],
      "start-apache": "/Applications/MAMP/bin/startApache.sh && /Applications/MAMP/bin/startMysql.sh",
      "lint": "parallel-lint --exclude vendor --exclude node_modules .",
      "phpstan": "phpstan analyse --memory-limit=1G",
      "phpcs": "phpcs",
      "phpcbf": "phpcbf",
      "check": [
          "@lint",
          "@phpstan",
          "@phpcs"
      ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.0",
    "php-parallel-lint/php-parallel-lint": "^1.4"
  }
}
